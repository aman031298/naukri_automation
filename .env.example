# Naukri Credentials
NAUKRI_EMAIL=your_email@example.com
NAUKRI_PASSWORD=your_password

# Job Preferences
JOB_KEYWORDS="Python Developer,Full Stack Developer,Data Scientist"
JOB_LOCATION="Bangalore"
EXCLUDE_KEYWORDS="senior,lead,manager,director,principal"
MAX_APPLICATIONS=10
MAX_JOB_AGE_DAYS=6

# Browser Settings
HEADLESS=false
USER_DATA_DIR=./browser_data
TIMEOUT=30000

# Database
DB_PATH=db/jobs_history.db

# Notifications
NOTIFICATIONS_ENABLED=true

# Report Settings
REPORT_DIR=./reports
SAVE_REPORTS=true

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Web service deployment (server.py / Render Web Service)
# Shared secret required in the X-Trigger-Token header of POST /run-job.
# Leave blank only for local testing — required in production so the
# job trigger isn't publicly callable by anyone who finds the URL.
TRIGGER_TOKEN=
PORT=10000

# Email report sent after each run (uses src/utils/email_sender.py)
EMAIL_USER=
EMAIL_PASSWORD=
REPORT_EMAIL_TO=